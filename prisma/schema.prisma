// =====================================================================
// Jam3iya — Prisma schema
// Multi-tenant charity management platform.
//
// Companion docs:
//   - docs/entity-model.md
//   - docs/permission-matrix.md
//   - docs/security-privacy-spec.md
//   - docs/design.md
//
// Conventions:
//   - All UUIDs are v7 (sortable).
//   - Money is amount_minor (BigInt) + currency (ISO 4217). Default TND.
//   - Timestamps are timestamptz (DateTime in Prisma).
//   - Soft delete via deletedAt.
//   - Encrypted (PII-HIGH) fields are stored as Bytes (AES-256-GCM ciphertext).
//   - Searchable encrypted fields keep a paired *_hash column = HMAC-SHA256.
//   - Postgres Row-Level Security and CHECK constraints are added in raw SQL
//     migrations (Prisma cannot express them directly).
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext, uuid_ossp(map: "uuid-ossp")]
}

