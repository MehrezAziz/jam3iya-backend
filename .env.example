# Application
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://jam3iya:devpass@localhost:5432/jam3iya?schema=public

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-please
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-please
JWT_ACCESS_TTL=900
# 2592000 = 30 days (stay logged in after closing the browser)
JWT_REFRESH_TTL=2592000
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Encryption (32-byte base64 master key; in prod use real KMS)
MASTER_ENCRYPTION_KEY=ZGV2LW1hc3Rlci1rZXktMzItYnl0ZXMtcGxlYXNlLXJvdGF0ZS0xMjM=
SEARCH_PEPPER=dev-pepper-please-rotate

# Redis (optional in v0; needed for BullMQ)
REDIS_URL=redis://localhost:6379

# Object storage (S3-compatible / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=jam3iya
S3_SECRET_KEY=jam3iya-dev
S3_BUCKET=jam3iya-dev
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Mail (Mailhog for dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@jam3iya.local

# Flouci (Tunisia payment gateway)
FLOUCI_APP_TOKEN=
FLOUCI_APP_SECRET=
FLOUCI_API_BASE=https://developers.flouci.com/api

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=info

# Optional — first-time platform admin (local seed). Omit after bootstrap; re-seed never resets passwords.
# SEED_PLATFORM_ADMIN_EMAIL=root@platform.local
# SEED_PLATFORM_ADMIN_PASSWORD=change-me-min-12-chars
# SEED_PLATFORM_ADMIN_NAME=Platform Root
